# Copy to .env (never commit) and fill in. Profiles `dev` and `e2e` ship dev-only defaults for everything below.
# Activate a profile with SPRING_PROFILES_ACTIVE=dev. Any other profile requires a real JWT_SECRET.

SPRING_PROFILES_ACTIVE=
# HS256 key, at least 32 bytes. Startup fails otherwise (outside dev/e2e).
JWT_SECRET=
# Token lifetime (Spring Duration, e.g. 8h or PT8H).
JWT_TTL=8h
# Comma-separated list of browser origins allowed by CORS.
CORS_ALLOWED_ORIGINS=

# Serve /v3/api-docs. Keep false in production (default); true in dev/e2e.
API_DOCS_ENABLED=false

DB_URL=jdbc:postgresql://localhost:5432/spacebooking
DB_USER=
DB_PASSWORD=

# Seeder (off unless SEED_ENABLED=true; on by default in dev/e2e).
SEED_ENABLED=false
SEED_ADMIN_PASSWORD=
SEED_MANAGER_PASSWORD=
SEED_EMPLOYEE_PASSWORD=
